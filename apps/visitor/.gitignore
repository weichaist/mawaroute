/config/*.json
!/config/example.json
.env
*.env
# Firebase native config files (only needed if you use `flutterfire configure`)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/firebase_app_id_file.json
# iOS secrets (keep Secrets.xcconfig.example)
ios/Flutter/Secrets.xcconfig
# Android signing
android/key.properties
*.jks
*.keystore
