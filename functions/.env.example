# Copy to functions/.env (or .env.<your-project-id>) and fill in.
# These are non-secret params. Secrets are set separately with
#   firebase functions:secrets:set NAME
# (MINTER_PRIVATE_KEY, RPC_URL, MORALIS_API_KEY, OPENAI_API_KEY,
#  GOOGLE_MAPS_API_KEY, GOOGLE_TRANSLATE_API_KEY, SENDGRID_API_KEY,
#  WEAVIATE_API_KEY, COHERE_API_KEY). See README.md.

# 80002 = Polygon Amoy testnet, 137 = Polygon mainnet
CHAIN_ID=80002
ERC20_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
ERC20_TOKEN_SYMBOL=GGMT
NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

OPENAI_MODEL=gpt-4.1
OPENAI_FAST_MODEL=gpt-4.1-mini

SENDGRID_FROM_EMAIL=noreply@example.com
SENDGRID_SHOP_TEMPLATE_ID=d-00000000000000000000000000000000

WEAVIATE_HOST=your-cluster.weaviate.cloud

NEWS_PUSH_TO_ALL_USERS=false
# Comma-separated FCM tokens that always receive news pushes
NEWS_PUSH_TEST_TOKENS=

# Only if you enable the Algolia triggers in index.js
# ALGOLIA_APP_ID=
# ALGOLIA_INDEX_NAME=mawaroute_jp
